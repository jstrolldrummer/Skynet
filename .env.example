# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15555555555

# Admin UI (HTTP basic auth — username is "admin")
ADMIN_PASSWORD=change-me

# Token required to call POST /tasks/send-followups (used by your scheduler)
TASK_TOKEN=change-me

# SQLite file location
DATABASE_PATH=./skynet.db

# Used in the message signature
COMPANY_NAME=Wyatt & Gray Custom Homes
SENDER_NAME=Joe

# Your personal phone in E.164 (preview text goes here, replies control the sweep)
OWNER_PHONE=+15125551234

# Public URL of the deployed app — used to verify Twilio webhook signatures.
# On Render, RENDER_EXTERNAL_URL is auto-set, so leave this blank in production.
# Leave blank locally too; signature validation is skipped when this is empty.
PUBLIC_URL=

# Local timezone for weekend / wall-clock checks
TIMEZONE=America/Chicago

# Skip the morning send on Saturday/Sunday in TIMEZONE. Set to false to text 7 days a week.
SKIP_WEEKENDS=true

# Dropbox sync. When all four are set, Subtext pulls the .xlsx from Dropbox
# automatically before each 7:30am preview, and on demand from the admin UI.
# Run `python -m app.dropbox_setup` once to mint a refresh token; see README.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_FILE_PATH=/subtext.xlsx
