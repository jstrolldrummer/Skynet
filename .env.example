# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLASSIFIER_MODEL=claude-sonnet-4-6
DRAFTER_MODEL=claude-sonnet-4-6

# --- Polling ---
POLL_INTERVAL_SECONDS=180
LOOKBACK_HOURS_ON_FIRST_RUN=24

# --- Gmail (Wyatt & Gray gmail account) ---
# Run `bid-watcher-auth-gmail` once after placing client_secret_gmail.json in ./secrets/
GMAIL_ENABLED=true
GMAIL_CLIENT_SECRET_FILE=./secrets/client_secret_gmail.json
GMAIL_TOKEN_FILE=./secrets/gmail_token.json
GMAIL_USER_EMAIL=estimating@wyattandgray.com

# --- Outlook / Microsoft 365 (Wyatt & Gray O365 account) ---
OUTLOOK_ENABLED=true
OUTLOOK_TENANT_ID=common
OUTLOOK_CLIENT_ID=
OUTLOOK_TOKEN_CACHE_FILE=./secrets/outlook_token_cache.json
OUTLOOK_USER_EMAIL=estimating@wyattandgray.com

# --- Dropbox ---
# Long-lived refresh token preferred. Run `bid-watcher-auth-dropbox` to mint one.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Path inside Dropbox to your existing Estimating folder (must start with /)
DROPBOX_ESTIMATING_PATH=/Wyatt and Gray/Estimating

# --- Templates / Output ---
PROPOSAL_TEMPLATE_PATH=./templates/proposal_template.docx
# Optional: drop a local copy of every created folder here for backup
LOCAL_MIRROR_DIR=

# --- Sender (Wyatt + Gray) cover-page info ---
SENDER_NAME=Joe Stroll
SENDER_COMPANY=Wyatt + Gray Custom Homes LLC
SENDER_PHONE=(475) 747-1804
SENDER_EMAIL=Joe@WyattGrayHomes.com
SENDER_ADDRESS=336 Rock Rimmon Rd, Stamford, CT 06903, USA

# --- State ---
STATE_DB_PATH=./data/state.sqlite3

# --- Safety ---
# Hard guarantee that the app will never send email replies.
NEVER_REPLY=true
