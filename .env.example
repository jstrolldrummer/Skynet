# RapidAPI key for unofficial Zillow API
# Sign up at https://rapidapi.com and subscribe to "Zillow.com" by apimaker (Basic plan is free).
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=zillow-com1.p.rapidapi.com

# Anthropic API key for vision-based rehab estimation
ANTHROPIC_API_KEY=your_anthropic_key_here

# Email settings (Gmail SMTP with app password recommended)
# Generate an app password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASSWORD=your_app_password_here
DIGEST_TO=youremail@gmail.com
DIGEST_FROM=youremail@gmail.com
