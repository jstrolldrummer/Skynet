# Skynet Dropbox connector credentials.
# Copy to .env (which is gitignored) OR set these as environment/session secrets.
#
# --- Option A: simplest, but the token expires after ~4 hours ---
DROPBOX_ACCESS_TOKEN=

# --- Option B: recommended, never expires (auto-refreshes) ---
# Create an app at https://www.dropbox.com/developers/apps (Scoped, Full Dropbox),
# enable files.metadata.read + files.content.read (+ .write to upload),
# then do the OAuth "offline" flow once to get a refresh token.
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
